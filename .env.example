# Copy to .env and fill in real values. Never commit .env.

# Public IP / DDNS name that WireGuard clients connect to
WG_HOST=vpn.example.com

# Admin UI login (password only)
ADMIN_PASSWORD=change-me
# bcrypt hash of ADMIN_PASSWORD; escape every $ as $$ for docker compose
PASSWORD_HASH=$$2a$$12$$replace-with-bcrypt-hash

# Samba credentials
SMB_USER=smb
SMB_PASS=change-me

# Cloudflare DDNS (ddns service)
CF_API_TOKEN=replace-with-cloudflare-api-token
CF_ZONE_ID=replace-with-zone-id
CF_RECORD_ID=replace-with-dns-record-id
CF_RECORD_NAME=home.example.com
DDNS_INTERVAL=300
